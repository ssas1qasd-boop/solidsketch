<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.solidsketch.app"
    android:versionCode="24"
    android:versionName="24">

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="34" />

    <!-- No permissions: the app is fully offline (the page is bundled in assets/),
         files are picked through the system picker and saved through MediaStore
         (API 29+) or the app-specific external files dir (API 24-28). -->

    <application
        android:label="SolidSketch"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:hardwareAccelerated="true">

        <!-- configChanges: rotation, resizing (split screen, foldables), keyboards, display
             size (density) and font size (fontScale; textZoom is pinned at 100) are handled
             in place, so they do not reload the 15 MB page. uiMode is left out on purpose:
             switching system dark mode recreates the activity, which applies the
             values-night theme (the WebView takes prefers-color-scheme from the theme);
             the page then restores its localStorage autosave. -->
        <activity
            android:name="com.solidsketch.app.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|keyboard|navigation|density|fontScale"
            android:windowSoftInputMode="adjustResize"
            android:hardwareAccelerated="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
